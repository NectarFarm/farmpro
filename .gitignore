# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
!.env.example
.env

# vercel
.vercel

# cloudflare / opennext build artifacts
.open-next/
.wrangler/

# typescript
*.tsbuildinfo
next-env.d.ts

# vscode
.vscode/*
.idea/*

# Remote Control runtime data
/remote-control/data/
!/remote-control/data/.gitkeep

# Sibling working directories that are NOT part of the app and must never be
# committed. apk-build holds android.keystore and keystore-password.txt — a
# signing key in git history cannot be un-leaked, only rotated.
/Frontend
/apk-build
/verify-221
.env*

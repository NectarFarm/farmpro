# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit .env; .env.example is safe to commit
.env
.env.local
.env.*.local
!.env.example

# mobile / capacitor (not part of this web deployment)
android/
ios/
capacitor.config.json
capacitor.config.ts
scripts/build-apk.sh

# cloudflare / wrangler (not our deployment target)
wrangler.toml
open-next.config.ts

# editor / IDE project files
.project
.gitlab-ci.yml

# vercel
.vercel

# cloudflare / opennext build artifacts
.open-next/
.wrangler/

# typescript
*.tsbuildinfo
next-env.d.ts

# vscode
.vscode/*
.idea/*

# Remote Control runtime data
/remote-control/data/
!/remote-control/data/.gitkeep


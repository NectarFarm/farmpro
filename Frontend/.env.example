# Copy to .env and fill in. Never commit real secrets.

# Postgres connection string (required in production)
DATABASE_URL=postgres://user:pass@localhost:5432/ifms

# HMAC signing secret for session cookies (min 16 chars; required real value in production)
SESSION_SECRET=change-me-to-a-long-random-string

# true = talk to /api/* (Postgres); false/omit = mock API for UI-only demo

# Set true only when the app is served over HTTPS (Secure cookies)
COOKIE_SECURE=false

# Optional AI advisor (OpenRouter)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Optional rate-limit tuning
# RATE_LIMIT_LOGIN_MAX=5
# RATE_LIMIT_LOGIN_IP_MAX=50
# RATE_LIMIT_WRITE_MAX=30
# RATE_LIMIT_READ_MAX=100
# RATE_LIMIT_WINDOW_MS=60000

# Cloudflare R2 object storage for photos (optional — without these, photos remain
# as base64 data URLs in Postgres, which is fine for small-scale use).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=ifms-photos

# ── Docker Compose ────────────────────────────────────────────────────────────
# These are the only vars you MUST set before running:
#   docker compose up --build -d
#
# The DATABASE_URL is wired internally in docker-compose.yml.
# You only need to provide SESSION_SECRET (and optionally PORT).

# Random secret for signing session cookies (min 32 chars).
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_me_to_a_long_random_string_at_least_32_chars

# Port the app is exposed on (default: 13000)
# PORT=13000

# ── Local development (pnpm dev) ──────────────────────────────────────────────
# Uncomment and fill in when running outside Docker.

# DATABASE_URL=postgresql://user:password@localhost:5432/farmpro
# NEXT_PUBLIC_API_URL=http://localhost:13000

# ── Optional: Umami analytics (production only) ───────────────────────────────
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# ── Optional: Africa's Talking SMS (order notifications) ──────────────────────
# Server-side only — never prefixed NEXT_PUBLIC_ so keys stay off the browser.
# If unset, SMS runs in demo mode (logs the message instead of sending).
# AT_USERNAME=
# AT_API_KEY=

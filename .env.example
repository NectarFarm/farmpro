# New IFMS backend connection (postgres:16, migrated with pnpm db:migrate)
DATABASE_URL=postgres://postgres:ifms@localhost:55433/ifms
# Tenant-scope fallback for standalone mock mode — real sessions (issue #221) provide the tenant from the authenticated user instead.
NEXT_PUBLIC_TENANT_ID=t1

# Peppers the worker-PIN lookup key (lib/auth.ts pinPrefilter). Set a
# strong random secret in production; the dev fallback only serves local demos.
# Leave this line commented out (do not declare it as an empty string) —
# lib/auth.ts and db/seed.mjs treat an empty AUTH_PIN_PEPPER as unset either
# way (issue #272), but an uncommented empty value is one accidental edit
# away from being an intentional-but-empty override again.
# AUTH_PIN_PEPPER=

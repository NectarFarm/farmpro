# New IFMS backend connection (postgres:16, migrated with pnpm db:migrate)
DATABASE_URL=postgres://postgres:ifms@localhost:55433/ifms
# Tenant-scope fallback for standalone mock mode — real sessions (issue #221) provide the tenant from the authenticated user instead.
NEXT_PUBLIC_TENANT_ID=t1

# Peppers the worker-PIN lookup key (lib/auth.ts pinPrefilter). Set a
# strong random secret in production; the dev fallback only serves local demos.
# Leave this line commented out (do not declare it as an empty string) —
# lib/auth.ts and db/seed.mjs treat an empty AUTH_PIN_PEPPER as unset either
# way (issue #272), but an uncommented empty value is one accidental edit
# away from being an intentional-but-empty override again.
# AUTH_PIN_PEPPER=

# Mail (feat/email-notifications, lib/email.ts). Resend's REST API, called
# via plain fetch — no SDK. With RESEND_API_KEY unset, every send is a
# logged no-op and every caller (an onboarding approval/rejection, a
# notification) still succeeds — this is safe to leave unset until a real
# key is issued.
# RESEND_API_KEY=
# Sender shown on outgoing mail — "Name <address>". Falls back to Resend's
# own no-setup-required sandbox sender (onboarding@resend.dev) until a real
# domain is verified.
# EMAIL_FROM=IFMS <onboarding@resend.dev>
# Origin used to build links embedded in mail (set-password, onboarding
# update). Only needed if the request's own Host header/VERCEL_URL ever
# doesn't reflect the real public URL — see lib/email.ts's resolveAppBaseUrl.
# NEXT_PUBLIC_APP_URL=https://ifms-puce.vercel.app
